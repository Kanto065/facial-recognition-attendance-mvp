# Python
backend/venv/
backend/__pycache__/
**/__pycache__/
*.pyc

# Model weights (large binaries — downloaded separately, see README)
backend/weights/*.onnx

# Runtime data (FAISS index, SQLite attendance DB)
backend/data/

# TLS cert/key (self-signed, generated locally, never commit private keys)
backend/certs/

# Local secrets (DB connection string, JWT secret key — never commit)
backend/.env

# Node / frontend
frontend/node_modules/
frontend/dist/

# Editor/OS cruft
.vscode/
.DS_Store
Thumbs.db
